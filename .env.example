# Copy to .env and fill in what you need. .env is git-ignored; never commit real keys.
# Variables already set in your environment take precedence over this file.

# Claude API (Anthropic target, Claude agent and model comparison, Anthropic judge)
ANTHROPIC_API_KEY=

# OpenAI or any OpenAI-compatible endpoint (openai target, OpenAI judge)
OPENAI_API_KEY=

# Claude agent (examples/claude_agent): model used when the URL names none
# AGENT_MODEL=claude-opus-5-5

# Demo bots: run them on a real model instead of the offline simulator
# BOT_LLM=anthropic
# BOT_MODEL=claude-opus-5-5

# Hosted web app: keeps domain verification codes valid across restarts
# INJECTPROBE_SECRET=
